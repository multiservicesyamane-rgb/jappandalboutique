# ================================================
# Jappandal Boutique — Configuration locale
# Copier ce fichier en .env et remplir les valeurs
# ================================================

# Base de données MySQL
DATABASE_URL=mysql://user:password@localhost:3306/jappandal_db

# Clé secrète JWT (session cookies) — mettre une longue chaîne aléatoire
JWT_SECRET=remplacez-par-une-chaine-aleatoire-longue-et-secrete

# Identifiants administrateur
ADMIN_EMAIL=admin@jappandal.com
ADMIN_PASSWORD=votre_mot_de_passe_admin

# Port du serveur (optionnel, défaut: 5000)
PORT=5000
