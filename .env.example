# ================================================
# Jappandal Boutique — Configuration locale
# Copier ce fichier en .env et remplir les valeurs
# ================================================

# Base de données MySQL
DATABASE_URL=mysql://user:password@localhost:3306/jappandal_db

# Clé secrète JWT (session cookies) — mettre une longue chaîne aléatoire
JWT_SECRET=remplacez-par-une-chaine-aleatoire-longue-et-secrete

# Identifiants administrateur
ADMIN_EMAIL=admin@jappandal.com
ADMIN_PASSWORD=votre_mot_de_passe_admin

# Port du serveur (optionnel, défaut: 5000)
PORT=5000

# ================================================
# Publication automatique sur les réseaux sociaux
# Ce site publie sur la page "Yamane_Shop" (repérée dans META_PAGES).
# ================================================
# META_PAGES contient la liste des pages avec leurs tokens.
# La page dont le nom contient "Yamane Shop" est utilisée automatiquement.
META_PAGES=[{"id":"PAGE_ID","name":"Yamane_Shop","token":"PAGE_TOKEN"}]
META_PAGE_ID=PAGE_ID
META_ACCESS_TOKEN=PAGE_TOKEN

# Instagram Business (doit être lié à la page Facebook ci-dessus)
INSTAGRAM_BUSINESS_ID=

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=

# Pinterest API v5
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# URL publique utilisée dans les liens des publications
SITE_URL=http://localhost:5000
